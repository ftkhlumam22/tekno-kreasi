# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-this"

# Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

